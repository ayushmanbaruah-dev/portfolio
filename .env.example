# ---- apps/api (set these in Render > portfolio-api > Environment) ----
GEMINI_API_KEY=
RESEND_API_KEY=
# Where the "Hire me" emails are delivered. With Resend's free test sender this
# MUST be the email address your Resend account was created with.
CONTACT_TO=
# Comma-separated list of allowed website origins (your Render static site URL)
CORS_ORIGIN=http://localhost:5173
# Optional overrides
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Kore
RESEND_FROM=Portfolio <onboarding@resend.dev>

# ---- apps/web (set in Render > portfolio-web > Environment, before build) ----
VITE_API_URL=http://localhost:8787
